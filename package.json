{
  "name": "@double-great/stylelint-a11y",
  "version": "3.8.1",
  "description": "Plugin for stylelint with a11y rules",
  "main": "src/index.js",
  "files": [
    "src",
    "!src/**/__tests__",
    "recommended.js",
    "strict.js"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./recommended": "./recommended.js",
    "./strict": "./strict.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/double-great/stylelint-a11y.git"
  },
  "author": "@double-great",
  "license": "MIT",
  "keywords": [
    "stylelint",
    "stylelint-plugin",
    "a11y",
    "accessibility"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint && npm run format:check",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "jest",
    "test:unit": "jest src",
    "test:integration": "jest test/integration",
    "test:e2e": "jest test/e2e",
    "test:system": "jest test/system",
    "test:compatibility": "jest test/system/compatibility.test.js",
    "test:all": "jest",
    "coverage": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage --runner=jest-runner src test/integration"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "peerDependencies": {
    "stylelint": ">=16.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-stylelint": "^27.0.0",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-light-runner": "^0.8.2",
    "jest-preset-stylelint": "^9.2.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0"
  },
  "bugs": {
    "url": "https://github.com/double-great/stylelint-a11y/issues"
  },
  "homepage": "https://github.com/double-great/stylelint-a11y#readme",
  "dependencies": {
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  }
}
